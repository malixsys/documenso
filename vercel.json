{
  "version": 2,
  "buildCommand": "turbo run build --filter=@documenso/remix && mkdir -p public && cp -r apps/remix/build/client/. public/",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "apps/remix/build/server/**"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, immutable, max-age=31536000" }
      ]
    }
  ]
}
