{
  "private": true,
  "name": "@documenso/root",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "version": "2.7.0",
  "scripts": {
    "postinstall": "patch-package",
    "dev": "turbo run dev --filter=@documenso/remix",
    "dev:remix": "turbo run dev --filter=@documenso/remix",
    "dev:docs": "turbo run dev --filter=@documenso/documentation",
    "dev:openpage-api": "turbo run dev --filter=@documenso/openpage-api",
    "start": "turbo run start --filter=@documenso/remix --filter=@documenso/documentation --filter=@documenso/openpage-api",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{js,jsx,cjs,mjs,ts,tsx,cts,mts,mdx}\"",
    "prepare": "husky && husky install || true",
    "commitlint": "commitlint --edit",
    "clean": "turbo run clean && rimraf node_modules",
    "d": "yarn dx && yarn translate:compile && yarn dev",
    "dx": "yarn install && yarn dx:up && yarn prisma:migrate-dev && yarn prisma:seed",
    "dx:up": "docker compose -f docker/development/compose.yml up -d",
    "dx:down": "docker compose -f docker/development/compose.yml down",
    "ci": "turbo run build --filter=@documenso/remix && turbo run test:e2e",
    "prisma:generate": "yarn with:env -- yarn workspace @documenso/prisma prisma:generate",
    "prisma:migrate-dev": "yarn with:env -- yarn workspace @documenso/prisma prisma:migrate-dev",
    "prisma:migrate-deploy": "yarn with:env -- yarn workspace @documenso/prisma prisma:migrate-deploy",
    "prisma:migrate-reset": "yarn with:env -- yarn workspace @documenso/prisma prisma:migrate-reset",
    "prisma:seed": "yarn with:env -- yarn workspace @documenso/prisma prisma:seed",
    "prisma:studio": "yarn with:env -- yarn workspace @documenso/prisma prisma:studio",
    "with:env": "dotenv -e .env -e .env.local --",
    "reset:hard": "yarn clean && yarn install && yarn prisma:generate",
    "precommit": "yarn install && git add package.json yarn.lock",
    "trigger:dev": "yarn with:env -- npx trigger-cli dev --handler-path=\"/api/jobs\"",
    "inngest:dev": "inngest dev -u http://localhost:3000/api/jobs",
    "make:version": "yarn version --no-git-tag-version",
    "translate": "yarn translate:extract && yarn translate:compile",
    "translate:extract": "lingui extract --clean",
    "translate:compile": "lingui compile"
  },
  "engines": {
    "npm": ">=10.7.0",
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@lingui/cli": "^5.6.0",
    "@prisma/client": "^6.19.0",
    "@trpc/client": "11.8.1",
    "@trpc/react-query": "11.8.1",
    "@trpc/server": "11.8.1",
    "@ts-rest/core": "^3.52.1",
    "@ts-rest/open-api": "^3.52.1",
    "@ts-rest/serverless": "^3.52.1",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.57.0",
    "husky": "^9.1.7",
    "inngest-cli": "^1.16.1",
    "lint-staged": "^16.2.7",
    "nanoid": "^5.1.6",
    "nodemailer": "^7.0.10",
    "pdfjs-dist": "5.4.296",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.2",
    "playwright": "1.56.1",
    "prettier": "^3.6.2",
    "prisma": "^6.19.0",
    "prisma-extension-kysely": "^3.0.0",
    "prisma-json-types-generator": "^3.6.2",
    "prisma-kysely": "^2.3.0",
    "rimraf": "^6.1.2",
    "superjson": "^2.2.5",
    "syncpack": "^14.0.0-alpha.27",
    "turbo": "^1.13.4",
    "vite": "^7.2.4",
    "vite-plugin-static-copy": "^3.1.4",
    "zod-openapi": "^4.2.4",
    "zod-prisma-types": "3.3.5"
  },
  "dependencies": {
    "@ai-sdk/google-vertex": "3.0.81",
    "@documenso/prisma": "*",
    "@libpdf/core": "^0.2.9",
    "@lingui/conf": "^5.6.0",
    "@lingui/core": "^5.6.0",
    "@prisma/extension-read-replicas": "^0.4.1",
    "ai": "^5.0.104",
    "cron-parser": "^5.5.0",
    "luxon": "^3.7.2",
    "patch-package": "^8.0.1",
    "posthog-node": "4.18.0",
    "react": "^18",
    "typescript": "5.6.2",
    "zod": "^3.25.76"
  },
  "resolutions": {
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7"
  },
  "overrides": {
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "lodash": "4.17.23",
    "pdfjs-dist": "5.4.296",
    "typescript": "5.6.2",
    "zod": "$zod",
    "fumadocs-mdx": {
      "zod": "^4.3.5"
    }
  }
}
